; lib/sandbox.aura — Aura host loop for scripts/rollout.py --host aura
; Snapshot restore is sandbox plumbing, never an SFT restore label.
; Fork is ast:snapshot, not a CLI fiber. Mutate only via mutate:rebind on a hot name.

(export sandbox:step-n sandbox:obs sandbox:tick-n sandbox:sess-obs
        sandbox:grid1 sandbox:grid2
        sandbox:kv-get sandbox:kv-put sandbox:kv-miss
        sandbox:fp-len sandbox:fp-head sandbox:fp-tail sandbox:fp-wrap)

(define (sandbox:step-n w n)
  (if (<= n 0) w
    (sandbox:step-n (step w (control w)) (- n 1))))

(define (sandbox-num w k)
  (try (let ((v (hash-ref w k))) (if (number? v) v #f)) (catch (e) #f)))

(define (sandbox:obs w epoch)
  (hash "t" (hash-ref w "t")
        "energy" (energy w)
        "sat" (sandbox-num w "sat")
        "x2" (sandbox-num w "x2")
        "epoch" epoch
        "world" w))

(define (sandbox:tick-n book sess n)
  (if (<= n 0) sess
    (let ((out (tick book sess)))
      (sandbox:tick-n book (hash-ref out "sess") (- n 1)))))

(define (sandbox:sess-obs sess epoch)
  (hash "id" (hash-ref sess "id")
        "fd" (hash-ref sess "fd")
        "alive" (hash-ref sess "alive")
        "seq" (try (hash-ref sess "seq") (catch (e) 0))
        "epoch" epoch
        "sess" sess))

(define (sandbox:grid1 fn xs)
  (if (null? xs) (quote ())
    (cons (try (fn (car xs)) (catch (e) #f))
          (sandbox:grid1 fn (cdr xs)))))

(define (sandbox:grid2 fn pairs)
  (if (null? pairs) (quote ())
    (let ((p (car pairs)))
      (cons (try (fn (car p) (car (cdr p))) (catch (e) #f))
            (sandbox:grid2 fn (cdr pairs))))))

; get: fixture alist ((1 . 10)); hit key 1, miss key 2.
(define (sandbox:kv-get fn)
  (let ((box (list (cons 1 10))))
    (list (try (fn box 1) (catch (e) #f))
          (try (fn box 2) (catch (e) #f)))))

; put: empty box, store (1 . 10). vals = (changed headed) as 0/1.
(define (sandbox:kv-put fn)
  (let ((b0 (quote ()))
        (b1 (try (fn (quote ()) 1 10) (catch (e) #f))))
    (list (if (or (not b1) (eq? b0 b1)) 0 1)
          (if (and b1 (not (null? b1))
                   (equal? (car (car b1)) 1)
                   (equal? (cdr (car b1)) 10))
            1 0))))

; miss: nonempty then empty. expect (#f #t) = key-present / empty-is-miss.
(define (sandbox:kv-miss fn)
  (list (try (fn (list (cons 1 10)) 1) (catch (e) #f))
        (try (fn (quote ()) 1) (catch (e) #f))))

; list-fp: empty vs (5 6). len/head return numbers. tail/wrap encode (null? . car-or-0).
(define (sandbox:fp-len fn)
  (list (try (fn (quote ())) (catch (e) #f))
        (try (fn (quote (5 6))) (catch (e) #f))))

(define (sandbox:fp-head fn)
  (sandbox:fp-len fn))

(define (sandbox:fp-null? v)
  (try (null? v) (catch (e) #f)))

(define (sandbox:fp-car-num v)
  (try (if (and (not (null? v)) (number? (car v))) (car v) 0) (catch (e) 0)))

(define (sandbox:fp-tail fn)
  (let ((a (try (fn (quote ())) (catch (e) #f)))
        (b (try (fn (quote (5 6))) (catch (e) #f))))
    (list (if (or (not a) (sandbox:fp-null? a)) 1 0)
          (sandbox:fp-car-num b))))

(define (sandbox:fp-wrap fn)
  (let ((r (try (fn 7) (catch (e) #f))))
    (list (if (or (not r) (sandbox:fp-null? r)) 0 1)
          (sandbox:fp-car-num r))))
